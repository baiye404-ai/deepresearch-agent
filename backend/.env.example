# ═══════════════════════════════════════════════════════════════════
# DeepResearch 环境变量模板
#
# 用法：
#   1. 复制本文件为 .env（该文件已被 .gitignore 忽略，不会入库）：
#        cp .env.example .env
#      或在项目根目录创建软链/复制到 backend/.env
#   2. 填入你自己的值，**不要把填好的 .env 提交到仓库**
#
# 安全提醒：本文件只允许出现占位符。真实密钥一旦提交进 Git 历史，
#          即便后续删除也仍可从历史中恢复，必须视为已泄露并立即轮换。
# ═══════════════════════════════════════════════════════════════════

# ── LLM / Agent 服务 ─────────────────────────────────────────────
# 你的 LLM 服务 API Key（阿里云百炼 DashScope 或任意 OpenAI 兼容服务）
APP_TOKEN=sk-your-api-key-here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# MCP 工具应用 ID（Web 搜索能力，来自 DashScope 应用配置）
MCP_APP_ID=

# 可选：DashScope 专用 Key/地址，不填则回退到 APP_TOKEN / 默认地址
# DASHSCOPE_API_KEY=
# DASHSCOPE_HTTP_BASE_URL=https://dashscope.aliyuncs.com/api/v1

# ── 可用模型列表（JSON 数组）────────────────────────────────────
# icon 取 Zap 或 Cpu；icon_color 用 Tailwind 颜色类
AVAILABLE_MODELS=[{"model_id":"qwen3.6-flash","display_name":"Qwen-Flash","icon":"Zap","icon_color":"yellow-400"},{"model_id":"qwen3.6-plus","display_name":"Qwen-Plus","icon":"Zap","icon_color":"orange-400"},{"model_id":"qwen3.7-max-2026-05-17","display_name":"Qwen-Max","icon":"Cpu","icon_color":"purple-400"}]

# ── 用户库（PostgreSQL）─────────────────────────────────────────
# 存 users / user_threads 表；用户名与 bcrypt 哈希在此
DATABASE_URL=postgresql+asyncpg://postgres:your-db-password@localhost:5432/deepresearch

# ── 会话 / 任务队列（Redis）─────────────────────────────────────
# 会话、Redis Streams 任务队列、SSE 事件流、搜索缓存都走这里
REDIS_URL=redis://localhost:6379/0

# 本机没有 Redis 时是否允许降级为进程内 fake Redis（仅本机地址生效）
# REDIS_ALLOW_FAKE=1

# ── LangGraph checkpoint 持久化 ─────────────────────────────────
# redis   : 需要 Redis Stack（RediSearch + RedisJSON 模块）
# postgres: 复用 DATABASE_URL，无需额外中间件（推荐）
# memory  : 重启即丢，仅调试用
# 留空则按 redis → postgres → memory 顺序自动回退
CHECKPOINT_BACKEND=postgres
# 若要给 checkpoint 单独一个库，可指定：
# CHECKPOINT_POSTGRES_URI=postgresql://postgres:your-db-password@localhost:5432/deepresearch

# ── 知识库（Milvus）─────────────────────────────────────────────
# 方式一：本地嵌入式 Milvus Lite（无需服务，填 .db 文件路径）
#   必须用 MILVUS_DB_PATH，不能写进 MILVUS_URI
#   （pymilvus 在 import 期会校验 MILVUS_URI，只接受 http(s):// 形式）
MILVUS_DB_PATH=./runtime/milvus.db

# 方式二：连接远端 Milvus standalone（把上面那行注释掉，启用下面这行）
# MILVUS_URI=http://localhost:19530

# ── Embedding（知识库向量化）───────────────────────────────────
# 不填则回退到 APP_TOKEN / LLM_BASE_URL
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v3
# 必须与所选 Embedding 模型的输出维度一致；换模型需重建集合并迁移数据
EMBEDDING_DIM=1024

# ── 知识库生命周期（时效过滤 / 置信度衰减）──────────────────────
# off | inform | freshness | lifecycle
KB_LIFECYCLE_MODE=freshness

# ── 交叉编码器重排（可选）──────────────────────────────────────
# 不启用时检索仍可用，只是少一层语义精排
# RERANKER_KB_ENABLED=false
# RERANKER_WEB_ENABLED=false
# RERANKER_MODEL=gte-rerank
# RERANKER_API_KEY=
# RERANKER_TOP_K=5
# RERANKER_MIN_SCORE=0.0

# ── 研究流程默认参数 ────────────────────────────────────────────
# 单轮 fan-out 的并行搜索数量；并发过高会触发外部搜索 API 限流
WEB_SEARCH_MAX_QPS=12
NUMBER_OF_INITIAL_QUERIES=2
MAX_RESEARCH_LOOPS=2

# ── 评估框架（可选）────────────────────────────────────────────
# Judge 模型，建议用可用的最强模型，且不要与 Agent 同模型（避免自偏好偏差）
# EVAL_MODEL=

# ── LangSmith 追踪（可选）──────────────────────────────────────
# LANGSMITH_API_KEY=
# LANGCHAIN_TRACING_V2=false
